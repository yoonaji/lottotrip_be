# 이 파일을 .env로 복사해서 쓴다.   cp .env.example .env
#
# ⚠️ .env를 읽는 것은 docker compose뿐이다. dotenv 의존성이 없어서
#    ./gradlew bootRun 으로 띄울 때는 반영되지 않는다. 로컬에서 직접 실행하려면
#    셸에서 export 하거나 IDE 실행 구성의 환경변수에 넣는다.
# ⚠️ 운영은 이 파일을 쓰지 않는다. scripts/deploy.sh가 SSM(/lottotrip-dev/*)의
#    파라미터를 긁어 EC2 안에 .env를 새로 만든다. 실제 키는 SSM에 넣는다.
#      aws ssm put-parameter --name "/lottotrip-dev/<이름>" --value "<값>" \
#        --type SecureString --overwrite --region ap-northeast-2

DB_NAME=lottotrip
DB_USERNAME=lottotrip
DB_PASSWORD=lottotrip

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes

AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
# 로컬 도커 컨테이너에는 IAM 역할이 없어서 S3를 쓰려면 키가 필요하다.
# 운영(EC2)은 인스턴스 역할로 붙으므로 이 두 값이 없다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


### 소셜 로그인 — 로그인 코드가 실제로 읽는 값 ###

# 구글: identity token(JWT)의 aud가 이 목록 안에 있어야 통과한다.
GOOGLE_AUDIENCES=

# 애플: identity token의 aud가 이 목록 안에 있어야 한다. 값은 앱 번들 ID(웹이면 Service ID).
APPLE_AUDIENCES=
# 애플 탈퇴용 환경변수
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_B64=<base64 인코딩된 .p8>

# 카카오: 토큰의 app_id가 이 값과 같아야 통과한다. 구글의 aud와 같은 역할이다.
KAKAO_APP_ID=


### 소셜 로그인 — 지금은 아무 코드도 읽지 않는 값 ###
#
# application.yml의 spring.security.oauth2.client.registration 블록이 읽는 값들인데,
# 그 블록을 쓰는 코드가 없다(SecurityConfig에 oauth2Login이 없다).
# ⚠️ 구글 클라이언트 ID를 GOOGLE_CLIENT_ID에 넣어도 로그인은 계속 400이다. 위의 GOOGLE_AUDIENCES에 넣는다.
KAKAO_CLIENT_ID=dummy-kakao-client-id
KAKAO_CLIENT_SECRET=dummy-kakao-client-secret
NAVER_CLIENT_ID=dummy-naver-client-id
NAVER_CLIENT_SECRET=dummy-naver-client-secret
GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret


# TourAPI (한국관광공사 / 공공데이터포털) — 5단계 장소 데이터 적재용
# ⚠️ 포털 마이페이지의 "일반 인증키(Decoding)" 값을 넣는다. Encoding 값을 넣으면
#    우리가 한 번 더 인코딩해서 이중 인코딩이 되고, 서버가 키를 못 알아본다.
#    비어 있으면 수집 기능만 꺼지고, 서버 기동과 나머지 API에는 영향이 없다.
TOUR_API_SERVICE_KEY=

# Claude API (Anthropic) — 미션 문구 생성용 (roadmap 6-5 ①)
# platform.claude.com 콘솔에서 발급한 API 키를 넣는다.
# 비어 있으면 미션 생성만 템플릿 방식으로 되돌아가고, 서버 기동과 나머지 API에는 영향이 없다.
ANTHROPIC_API_KEY=
